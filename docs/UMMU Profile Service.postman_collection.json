            "description": "Periksa apakah Profile Service tersedia melalui Kong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check berhasil', function () {",
                  "    pm.response.to.have.status(200);",
