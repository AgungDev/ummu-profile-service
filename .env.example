APP_NAME=ummu-profile-service
APP_VERSION=1.0.0
APP_ENV=development
APP_PORT=9002

DB_HOST=profile_db
DB_PORT=5432
DB_USER=profile
DB_PASSWORD=change-me
DB_NAME=ummu_profile
DB_SSLMODE=disable
DB_PORT_PUBLISHED=54322

AUTH_ISSUER=https://auth.ummu.ac.id
AUTH_AUDIENCE=profile-service
JWKS_URL=http://auth_service:9001/.well-known/jwks.json
JWKS_ALLOWED_HTTP_HOSTS=auth_service

# Temporary credentials used only by the one-time Auth -> Profile name import.
LEGACY_AUTH_DB_HOST=auth_db
LEGACY_AUTH_DB_PORT=5432
LEGACY_AUTH_DB_USER=
LEGACY_AUTH_DB_PASSWORD=
LEGACY_AUTH_DB_NAME=
LEGACY_AUTH_DB_SSLMODE=disable

# Store avatars on local disk. Use S3 settings instead by clearing this value.
AVATAR_STORAGE_DIR=/data/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:7000/api/v1/profiles/avatars

# Optional S3-compatible storage; leave empty to use AVATAR_STORAGE_DIR.
AVATAR_ENDPOINT=
AVATAR_BUCKET=
AVATAR_ACCESS_KEY=
AVATAR_SECRET_KEY=
AVATAR_USE_SSL=false
AVATAR_MAX_BYTES=5242880

# Kong and Profile Service must share the Auth Service Docker network.
AUTH_DOCKER_NETWORK=auth-service_auth_net
