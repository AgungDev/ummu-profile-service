    {
      "name": "My Profile",
      "description": "Endpoint /me selalu menggunakan user_id dari claim sub token, bukan dari request body.",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/profiles/me",
            "description": "Membuat profil awal secara idempotent jika profil belum tersedia."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profil sendiri berhasil diambil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response berisi user_id dan nama profil', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.user_id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data).to.have.property('full_name');",
                  "});",
                  "if (body.data && body.data.user_id) {",
                  "    pm.collectionVariables.set('user_id', body.data.user_id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
