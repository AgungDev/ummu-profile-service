  "item": [
    {
      "name": "Auth Service",
      "description": "Login menggunakan akun Auth Service. Access token disimpan otomatis untuk request lain; token dari login service ini memiliki audience profile-service.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "description": "Isi username dan password dari Auth Service pada collection variables. Token hasil login disimpan ke variable access_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response berisi access token', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.data && body.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', body.data.access_token);",
                  "    if (body.data.user && body.data.user.id) {",
                  "        pm.collectionVariables.set('user_id', body.data.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
